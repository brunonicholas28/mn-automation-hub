# Copy this to .env.local for local testing (vercel env pull can also generate it).
# Add all of these as Production environment variables in the Vercel dashboard
# (Project -> Settings -> Environment Variables) before deploying - never
# commit real values to git.

# --- Apollo ---
APOLLO_API_KEY=
APOLLO_STAGE_ID=6a8ab4ad5a018d0020c4bd18

# --- Pipedrive ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_PIPELINE_ID=4
PIPEDRIVE_STAGE_ID_NEW_LEAD=20
# Your Pipedrive subdomain, e.g. "marinanicholas" for marinanicholas.pipedrive.com
# (used only to build clickable deal links in the digest email, not for API calls)
PIPEDRIVE_COMPANY_DOMAIN=

# --- Instantly ---
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# --- Digest email (reuses the Resend account already set up for the report pipeline) ---
RESEND_API_KEY=
DIGEST_FROM_EMAIL=hello@marinanicholas.com
DIGEST_TO_EMAIL=

# --- Security ---
# Random string; also set this as the value Vercel's cron invoker sends.
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` to cron
# routes when this env var is set - stops anyone else from hitting the URL.
CRON_SECRET=

# --- Vercel KV (auto-filled once you connect a KV store - Storage tab -> Create Database -> KV) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
